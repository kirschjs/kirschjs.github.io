Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalPsi]", "total"], 
    RowBox[{"(", 
     RowBox[{"x", ",", "y"}], ")"}]}], "=", 
   RowBox[{
    SubscriptBox["A", "0"], 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "0"}], 
      SubscriptBox["N", "max"]], 
     RowBox[{"Sin", "[", 
      RowBox[{"k", 
       RowBox[{"(", 
        RowBox[{
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"n", "a"}], ")"}], "2"], "+", 
           SuperscriptBox["y", "2"]}]], "-", 
         FractionBox["t", "k"]}]}]}]}]}]}]}], "]"}]], "Text",
