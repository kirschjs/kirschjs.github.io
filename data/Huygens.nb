Cell[BoxData[
 RowBox[{
  RowBox[{"TotalAmplitude", "[", 
   RowBox[{
   "x_", ",", "y_", ",", "t_", ",", "a_", ",", "Nmax_", ",", "k_", ",", 
    "A0_"}], "]"}], ":=", 
  RowBox[{"Total", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"A0", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{
        RowBox[{"k", " ", 
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"n", " ", "a"}], "-", "x"}], ")"}], "2"], "+", 
           SuperscriptBox["y", "2"]}]]}], "-", 
        RowBox[{"t", "/", "k"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"Range", "[", "Nmax", "]"}]}], "}"}]}], "]"}], 
   "]"}]}]], "Input",
