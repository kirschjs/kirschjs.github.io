Notebook[{
Cell[TextData[{
 "It takes the sun(moon) 24h(24.8412h) to reach the same meridian \
(North-South), \[Implies] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "=", 
    RowBox[{
     FractionBox[
      RowBox[{"2", "\[Pi]"}], "T"], "=", 
     RowBox[{
      RowBox[{
       FractionBox["360", "h"], "\[Implies]", 
       OverscriptBox["D", "~"]}], "=", 
      RowBox[{"15", 
       RowBox[{"(", "14.4", ")"}], 
       FractionBox["Deg", "h"]}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5fa55769-584f-4dbf-88f8-a47284c89774"],
 "\nAnd look at what this seemingly tiny offset produces in sea-level:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Eta]", "(", "t", ")"}], "=", 
    RowBox[{
     RowBox[{"sin", "(", 
      RowBox[{"2", 
       SubscriptBox[
        OverscriptBox["D", "~"], "sol"], "t"}], ")"}], "+", 
     RowBox[{"sin", "(", 
      RowBox[{"2", 
       SubscriptBox[
        OverscriptBox["D", "~"], "lun"], "t"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "505be940-267f-4c63-ae2a-0a2dd2c1d1c9"]
}], "Text",
 CellChangeTimes->{{3.939784404487495*^9, 3.939784466361553*^9}, {
  3.939784551422901*^9, 3.939784598979973*^9}, {3.93978478368056*^9, 
  3.939784950302092*^9}},ExpressionUUID->"46570264-70e4-4d8b-b7b9-\
cf1bfc743764"],

