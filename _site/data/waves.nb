        "], $CellContext`hArrows[
         Pattern[$CellContext`n, 
          Blank[]], 
         Pattern[$CellContext`L, 
          Blank[]], 
         Pattern[$CellContext`\[Lambda], 
          Blank[]], 
         Pattern[$CellContext`end, 
          
          Blank[]]] := ($CellContext`hArrows[$CellContext`n, $CellContext`L, \
$CellContext`\[Lambda], $CellContext`end] = 
        If[$CellContext`end == "none", {}, {Gray, 
           Arrowheads[{-$CellContext`\[Epsilon], $CellContext`\[Epsilon]}], 
           
           Outer[$CellContext`myArrow[#2, #]& , $CellContext`H 
            Range[-0.8, 0.8, 0.4], 
            Partition[
             Join[
              
              Map[# - 0.075 $CellContext`\[Lambda] 
               Cos[(4 Pi #)/$CellContext`\[Lambda] + Pi/2]& , 
               Range[
               0., $CellContext`L + $CellContext`\[Epsilon] $CellContext`\
\[Lambda], $CellContext`\[Lambda]/If[
                 And[$CellContext`end == "closed", $CellContext`n == 1], 26, 
                 If[$CellContext`n <= 2, 14, 
                  If[$CellContext`n <= 5, 10, 6]]]]], 
              If[$CellContext`end == "closed", {$CellContext`L}, {}]], 2, 1], 
            1]}]), $CellContext`myArrow[{
          Pattern[$CellContext`x1, 
           Blank[]], 
          Pattern[$CellContext`x2, 
           Blank[]]}, 
         Pattern[$CellContext`y, 
          Blank[]]] := Switch[
         Norm[$CellContext`x2 - $CellContext`x1], 
         PatternTest[
          Blank[], # < 0.1& ], 
         Point[{($CellContext`x1 + $CellContext`x2)/2, $CellContext`y}], 
         Blank[], 
         Arrow[{{$CellContext`x1, $CellContext`y}, {$CellContext`x2, \
$CellContext`y}}, $CellContext`\[Epsilon]]], $CellContext`dlabels[
         Pattern[$CellContext`n, 
          Blank[]], 
         Pattern[$CellContext`L, 
          Blank[]], 
         Pattern[$CellContext`\[Lambda], 
          Blank[]], 
         Pattern[$CellContext`end, 
          
          Blank[]]] := ($CellContext`dlabels[$CellContext`n, $CellContext`L, \
$CellContext`\[Lambda], $CellContext`end] = {{
           Map[Text[
             Subscript["N", "d"], #]& , 
            
            Table[{$CellContext`x, 
              0.8}, {$CellContext`x, $CellContext`\[Lambda]/
              4, $CellContext`L, $CellContext`\[Lambda]/2}]]}, {
           Map[Text[
             Subscript["A", "d"], #]& , 
            
            Table[{$CellContext`x, 0.8}, {$CellContext`x, 
              0, $CellContext`L, $CellContext`\[Lambda]/
              2}]]}}), $CellContext`plabels[
         Pattern[$CellContext`n, 
          Blank[]], 
         Pattern[$CellContext`L, 
          Blank[]], 
         Pattern[$CellContext`\[Lambda], 
          Blank[]], 
         Pattern[$CellContext`end, 
          
          Blank[]]] := ($CellContext`plabels[$CellContext`n, $CellContext`L, \
$CellContext`\[Lambda], $CellContext`end] = {{
           Map[Text[
             Subscript["A", "p"], #]& , 
            
            Table[{$CellContext`x, -0.85}, {$CellContext`x, $CellContext`\
\[Lambda]/4, $CellContext`L, $CellContext`\[Lambda]/2}]]}, {
           Map[Text[
             Subscript["N", "p"], #]& , 
            
            Table[{$CellContext`x, -0.85}, {$CellContext`x, 
              0, $CellContext`L, $CellContext`\[Lambda]/2}]]}})}; 
     Typeset`initDone$$ = True),
